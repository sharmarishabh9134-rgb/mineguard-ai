# MineGuard AI - Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# Backend API base URL. Used by the concern form in production and by Vite's dev proxy.
# In development (default): Vite proxies /api to http://127.0.0.1:5002 automatically.
# Override only if your backend runs on a different host/port:
# VITE_API_URL=http://127.0.0.1:5002

# For production builds (for example on Vercel), set this to your deployed backend origin.
# Both https://backend.example.com and https://backend.example.com/api are accepted.
# VITE_API_URL=https://your-backend.example.com
