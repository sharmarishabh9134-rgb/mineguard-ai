# MineGuard AI - Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server port (local default 5002; deployment platforms can set PORT)
PORT=5002

# MongoDB connection string
# Local default (no auth):
MONGODB_URI=mongodb://localhost:27017/mineguard_db
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mineguard_db?retryWrites=true&w=majority

# Node environment: development | production
NODE_ENV=development

# JWT secret for signing auth tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret

# Google Gemini API key (used for AI assistant features)
# Get one at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI features.
GOOGLE_API_KEY=

# ML service (optional locally; required for production ML predictions)
ML_SERVICE_URL=
ML_SERVICE_TOKEN=

# Optional comma-separated browser-origin allowlist for external frontends.
# Add the exact deployed Vercel origin, e.g. https://your-app.vercel.app (no path).
# The bundled production frontend is served from the backend's own origin.
CORS_ORIGINS=
